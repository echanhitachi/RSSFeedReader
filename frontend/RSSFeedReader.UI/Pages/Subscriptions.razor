@page "/"
@using RSSFeedReader.UI.Services
@inject SubscriptionApiClient SubscriptionApiClient

<PageTitle>Subscriptions</PageTitle>

<h1>Subscriptions</h1>

<div class="input-group mb-3">
    <input @bind="_newUrl" @bind:event="oninput" class="form-control" placeholder="Enter a feed URL" disabled="@_isValidating" />
    <button class="btn btn-primary" @onclick="AddSubscriptionAsync" disabled="@_isValidating">
        @(_isValidating ? "Validating..." : "Add")
    </button>
</div>

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <p>@_statusMessage</p>
}

<ul>
    @foreach (var subscription in _subscriptions)
    {
        var state = GetRowState(subscription.Id);
        <li class="mb-2">
            @subscription.Url
            <button class="btn btn-sm btn-outline-secondary ms-2" disabled="@(state.IsLoading)" @onclick="() => RefreshSubscriptionAsync(subscription.Id)">
                @(state.IsLoading ? "Refreshing..." : "Refresh")
            </button>
            <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => RemoveSubscriptionAsync(subscription.Id)">Remove</button>

            @if (state.ErrorMessage is not null)
            {
                <p class="text-danger mb-0">@state.ErrorMessage</p>
            }
            else if (state.Items is not null)
            {
                <ul>
                    @foreach (var item in state.Items)
                    {
                        <li>
                            <a href="@item.Link">@(string.IsNullOrEmpty(item.Title) ? "(no title)" : item.Title)</a>
                        </li>
                    }
                </ul>
            }
        </li>
    }
</ul>

@code {
    private string _newUrl = string.Empty;
    private string? _statusMessage;
    private bool _isValidating;
    private List<Subscription> _subscriptions = new();
    private readonly Dictionary<Guid, RowState> _rowStates = new();

    private sealed class RowState
    {
        public bool IsLoading { get; set; }
        public List<FeedItem>? Items { get; set; }
        public string? ErrorMessage { get; set; }
    }

    private RowState GetRowState(Guid id)
    {
        if (!_rowStates.TryGetValue(id, out var state))
        {
            state = new RowState();
            _rowStates[id] = state;
        }

        return state;
    }

    protected override async Task OnInitializedAsync()
    {
        _subscriptions = await SubscriptionApiClient.GetSubscriptionsAsync();
    }

    private async Task AddSubscriptionAsync()
    {
        if (string.IsNullOrWhiteSpace(_newUrl))
        {
            return;
        }

        _isValidating = true;
        _statusMessage = null;
        try
        {
            var result = await SubscriptionApiClient.AddSubscriptionAsync(_newUrl);
            if (result.Success && result.Subscription is not null)
            {
                _subscriptions.Add(result.Subscription);
                _statusMessage = $"Added \"{result.Subscription.Url}\".";
                _newUrl = string.Empty;
            }
            else
            {
                _statusMessage = result.ErrorMessage;
            }
        }
        finally
        {
            _isValidating = false;
        }
    }

    private async Task RemoveSubscriptionAsync(Guid id)
    {
        await SubscriptionApiClient.RemoveSubscriptionAsync(id);
        _subscriptions.RemoveAll(s => s.Id == id);
        _rowStates.Remove(id);
    }

    private async Task RefreshSubscriptionAsync(Guid id)
    {
        var state = GetRowState(id);
        state.IsLoading = true;
        state.ErrorMessage = null;
        StateHasChanged();

        try
        {
            var result = await SubscriptionApiClient.RefreshSubscriptionAsync(id);
            if (result.Success)
            {
                state.Items = result.Items;
                state.ErrorMessage = null;
            }
            else
            {
                state.ErrorMessage = result.ErrorMessage;
                state.Items = null;
            }
        }
        finally
        {
            state.IsLoading = false;
        }
    }
}
